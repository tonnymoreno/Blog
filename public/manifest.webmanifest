{
  "name": "Escribir · tonny.blog",
  "short_name": "Escribir",
  "description": "Editor para escribir y publicar entradas en tonny.blog, y descargar las imágenes para redes.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "/editor/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#FFFFFF",
  "theme_color": "#FFFFFF",
  "categories": ["productivity", "news"],
  "icons": [
    { "src": "/app/icono-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/app/icono-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/app/icono-recortable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Entrada nueva",
      "short_name": "Nueva",
      "url": "/editor/?nueva=1",
      "icons": [{ "src": "/app/icono-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Mis entradas",
      "short_name": "Entradas",
      "url": "/editor/?vista=entradas",
      "icons": [{ "src": "/app/icono-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Imágenes para redes",
      "short_name": "Imágenes",
      "url": "/editor/?vista=imagenes",
      "icons": [{ "src": "/app/icono-192.png", "sizes": "192x192" }]
    }
  ]
}
