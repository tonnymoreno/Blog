---
import '../styles/global.css';
import { FOTO_PERFIL } from '../lib/perfil';
import { getCollection } from 'astro:content';
import { slugify, categoryColor } from '../lib/slug';

interface Props {
  title: string;
  description?: string;
  /** Tarjeta de vista previa al compartir. Por defecto, la del sitio. */
  image?: string;
  /** Fecha de publicacion, para las entradas. */
  published?: Date;
  /** Entrada abierta en el panel de lectura, si la hay. */
  activeSlug?: string;
  /** Filtra el panel de la lista a una sola categoría. */
  category?: string;
  /** Encabezado del panel de la lista. */
  listTitle?: string;
  /** Texto de la barra del panel de lectura. */
  crumb?: string;
  /** En móvil se muestra un solo panel: el de lista o el de lectura. */
  view?: 'list' | 'reader';
}

const {
  title,
  description = 'Apuntes sobre sistemas, datos y operaciones — Tonny',
  image,
  published,
  activeSlug,
  category,
  listTitle,
  crumb,
  view = 'reader',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// Las redes exigen direcciones absolutas para la imagen de la vista previa.
const tarjeta = new URL(image ?? `${base}og/sitio.png`, Astro.site);
const here = Astro.url.pathname.replace(/\/$/, '');
const isHere = (path: string) => here === path.replace(/\/$/, '');

const all = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

// Las categorías salen de las entradas: al publicar una nueva, aparece sola.
const categories = [...new Set(all.map((p) => p.data.category))]
  .map((name) => ({
    name,
    slug: slugify(name),
    color: categoryColor(name),
    count: all.filter((p) => p.data.category === name).length,
  }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const listed = category ? all.filter((p) => p.data.category === category) : all;

const fmt = (d: Date) =>
  d.toLocaleDateString('es-MX', { day: 'numeric', month: 'short' });
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="canonical" href={canonicalURL} />
  <title>{title} — Tonny</title>
  <meta name="description" content={description} />

  <!-- Vista previa al compartir el enlace -->
  <meta property="og:type" content={published ? 'article' : 'website'} />
  <meta property="og:site_name" content="Tonny" />
  <meta property="og:locale" content="es_MX" />
  <meta property="og:title" content={`${title} — Tonny`} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={tarjeta} />
  <!-- Algunos clientes, WhatsApp entre ellos, buscan esta variante -->
  <meta property="og:image:secure_url" content={tarjeta} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`${title} — Tonny`} />
  {published && <meta property="article:published_time" content={published.toISOString()} />}
  {published && <meta property="article:author" content="Tonny" />}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} — Tonny`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={tarjeta} />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="alternate" type="application/rss+xml" title="Tonny" href={`${base}rss.xml`} />
  <script is:inline>
    const t = localStorage.getItem('theme') ??
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.documentElement.setAttribute('data-theme', t);
    if (localStorage.getItem('listaPlegada') === '1') {
      document.documentElement.setAttribute('data-lista', 'off');
    }
  </script>
</head>

<body>
  <header class="mobile-bar">
    <button class="mb-btn" id="menu-toggle" type="button"
            aria-label="Abrir el menú" aria-expanded="false" aria-controls="rail">☰</button>
    {view === 'reader' && (
      <a href={base} class="mb-btn" data-back aria-label="Volver al listado">←</a>
    )}
    <span class="mobile-bar-title">{crumb ?? title}</span>
    <button class="mb-btn" id="theme-toggle-movil" type="button" aria-label="Cambiar el tema">
      <svg viewBox="0 0 16 16" width="17" height="17" aria-hidden="true">
        <circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="1.3" />
        <path d="M8 2a6 6 0 0 0 0 12Z" fill="currentColor" />
      </svg>
    </button>
  </header>
  <div class="rail-fondo" id="rail-fondo" hidden></div>

  <div class="shell" data-view={view}>
    <!-- Panel 1 · navegación y categorías -->
    <aside class="rail" id="rail">
      <a href={base} class="rail-top">
        <img class="rail-photo" src={`${base}${FOTO_PERFIL}`} alt="" width="28" height="28" />
        <span class="rail-name">Tonny</span>
      </a>

      <div class="rail-section">
        <a href={base} class="rail-item" aria-current={isHere(base) ? 'page' : undefined}>
          <span class="rail-ico">⌂</span> Inicio
        </a>
        <a href={`${base}about`} class="rail-item" aria-current={isHere(`${base}about`) ? 'page' : undefined}>
          <span class="rail-ico">◔</span> Acerca
        </a>
      </div>

      <div class="rail-section">
        <p class="rail-heading">Categorías</p>
        {categories.map((cat) => (
          <a
            href={`${base}categoria/${cat.slug}`}
            class="rail-item"
            aria-current={isHere(`${base}categoria/${cat.slug}`) ? 'page' : undefined}
          >
            <span class="rail-swatch" style={`background:${cat.color}`}></span>
            {cat.name}
            <span class="rail-count">{cat.count}</span>
          </a>
        ))}
      </div>

    </aside>

    <!-- Panel 2 · listado de entradas -->
    <section class="list">
      <div class="list-bar">
        <span class="list-bar-title">
          <span>{listTitle ?? 'Todas las entradas'}</span>
        </span>
        <span class="pill">{listed.length}</span>
      </div>
      <div class="list-scroll">
        {listed.length === 0 && <p class="list-empty">Todavía no hay entradas aquí.</p>}
        {listed.map((post) => (
          <a
            href={`${base}posts/${post.slug}`}
            class="entry"
            aria-current={activeSlug === post.slug ? 'page' : undefined}
          >
            <span class="entry-top">
              <span class="entry-title">{post.data.title}</span>
              <span class="entry-date">{fmt(post.data.date)}</span>
            </span>
            <span class="entry-cat">
              <span class="rail-swatch" style={`background:${categoryColor(post.data.category)}`}></span>
              {post.data.category}
              <span class="entry-cat-fecha">· {fmt(post.data.date)}</span>
            </span>
            {post.data.description && <span class="entry-excerpt">{post.data.description}</span>}
            {post.data.tags && post.data.tags.length > 0 && (
              <span class="entry-tags">
                {post.data.tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
              </span>
            )}
          </a>
        ))}
      </div>
    </section>

    <!-- Panel 3 · lectura -->
    <section class="reader">
      <div class="reader-bar">
        <span class="reader-crumb">
          {view === 'reader' && (
            <a href={base} class="btn" data-back style="display:none;">←</a>
          )}
          <span>{crumb ?? title}</span>
        </span>
        <span class="reader-acts">
          <button class="btn btn-icon" id="list-toggle" type="button" title="Ocultar o mostrar el listado" aria-label="Ocultar o mostrar el listado">⇤</button>
          <button class="btn" id="theme-toggle" type="button">Tema</button>
        </span>
      </div>
      <div class="page">
        <div class="page-inner">
          <slot />
        </div>
      </div>
    </section>
  </div>
</body>

<script>
  const root = document.documentElement;

  const listBtn = document.getElementById('list-toggle');
  const paintList = () => {
    const off = root.getAttribute('data-lista') === 'off';
    if (listBtn) {
      listBtn.textContent = off ? '⇥' : '⇤';
      listBtn.title = off ? 'Mostrar el listado' : 'Ocultar el listado';
    }
  };
  paintList();
  listBtn?.addEventListener('click', () => {
    const off = root.getAttribute('data-lista') === 'off';
    if (off) { root.removeAttribute('data-lista'); localStorage.removeItem('listaPlegada'); }
    else { root.setAttribute('data-lista', 'off'); localStorage.setItem('listaPlegada', '1'); }
    paintList();
  });

  const cambiarTema = () => {
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
  };
  document.getElementById('theme-toggle')?.addEventListener('click', cambiarTema);
  document.getElementById('theme-toggle-movil')?.addEventListener('click', cambiarTema);

  // ── Cajón de navegación (solo móvil) ──
  const menuBtn = document.getElementById('menu-toggle');
  const fondo = document.getElementById('rail-fondo');

  function cerrarMenu() {
    root.removeAttribute('data-menu');
    menuBtn?.setAttribute('aria-expanded', 'false');
    if (fondo) fondo.hidden = true;
    document.body.style.overflow = '';
  }

  menuBtn?.addEventListener('click', () => {
    const abierto = root.getAttribute('data-menu') === 'on';
    if (abierto) return cerrarMenu();
    root.setAttribute('data-menu', 'on');
    menuBtn.setAttribute('aria-expanded', 'true');
    if (fondo) fondo.hidden = false;
    document.body.style.overflow = 'hidden';
    // El foco entra en el cajón: si no, el lector de pantalla se queda fuera.
    document.querySelector<HTMLElement>('.rail .rail-item')?.focus();
  });

  fondo?.addEventListener('click', cerrarMenu);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && root.getAttribute('data-menu') === 'on') cerrarMenu();
  });
  // Al ensanchar la ventana el cajón deja de tener sentido.
  window.addEventListener('resize', () => {
    if (window.innerWidth > 900) cerrarMenu();
  });

  // En móvil, el panel de lectura necesita una vuelta explícita al listado.
  const back = document.querySelector('[data-back]') as HTMLElement | null;
  if (back) {
    const sync = () => { back.style.display = window.innerWidth <= 900 ? '' : 'none'; };
    sync();
    window.addEventListener('resize', sync);
  }
</script>
</html>
