---
import '../styles/global.css';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const posts = await getCollection('posts');
const categories = [...new Set(posts.map((p) => p.data.category))].sort();
const today = new Date().toISOString().slice(0, 10);
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Escribir — Tonny</title>
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- App instalable: se añade a la pantalla de inicio y abre sin barra. -->
  <link rel="manifest" href={`${base}manifest.webmanifest`} />
  <link rel="apple-touch-icon" href={`${base}app/icono-apple-180.png`} />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="Escribir" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#191919" media="(prefers-color-scheme: dark)" />
  <script is:inline>
    const t = localStorage.getItem('theme') ??
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.documentElement.setAttribute('data-theme', t);
  </script>
</head>

<body>
  <div class="ed-shell">
    <header class="ed-bar">
      <h1 class="visual-oculto">Escribir una entrada para tonny.blog</h1>
      <span class="reader-crumb">
        <a href={base} class="btn ed-volver" aria-label="Volver al blog">←</a>
        <span id="ed-crumb">Entrada sin título</span>
        <span class="pill" id="ed-state">Borrador local</span>
      </span>
      <span class="reader-acts">
        <span class="ed-solo-ancho">
          <button class="btn" id="ed-new" type="button">Nueva</button>
          <button class="btn" id="ed-diagramas" type="button">Diagramas</button>
          <button class="btn" id="ed-redes" type="button" title="Imágenes para redes sociales">Redes</button>
          <button class="btn" id="ed-list" type="button">Mis entradas</button>
          <button class="btn" id="ed-key" type="button">Acceso</button>
        </span>
        <button class="btn btn-primary" id="ed-publish" type="button">Publicar</button>
      </span>
    </header>

    <main class="ed-doc">
      <div class="page-inner">
        <input class="ed-title" id="ed-titulo" placeholder="Sin título" autocomplete="off" />

        <details class="ed-plegable" id="ed-detalles">
          <summary class="ed-plegable-tapa">
            <span>Detalles de la entrada</span>
            <span class="ed-plegable-resumen" id="ed-detalles-resumen"></span>
          </summary>
          <div class="props ed-props">
          <label class="prop">
            <span class="prop-key">Fecha</span>
            <span class="prop-val"><input type="date" id="ed-fecha" value={today} /></span>
          </label>
          <label class="prop">
            <span class="prop-key">Categoría</span>
            <span class="prop-val">
              <input id="ed-categoria" list="ed-cats" placeholder="Ciencia de datos" autocomplete="off" />
              <datalist id="ed-cats">
                {categories.map((c) => <option value={c}></option>)}
              </datalist>
            </span>
          </label>
          <label class="prop">
            <span class="prop-key">Etiquetas</span>
            <span class="prop-val"><input id="ed-tags" placeholder="separadas, por, comas" autocomplete="off" /></span>
          </label>
          <label class="prop">
            <span class="prop-key">Resumen</span>
            <span class="prop-val"><input id="ed-desc" placeholder="Una línea que aparece en el listado" autocomplete="off" /></span>
          </label>
          <label class="prop">
            <span class="prop-key">Borrador</span>
            <span class="prop-val">
              <input type="checkbox" id="ed-draft" />
              <span class="ed-hint">Si se marca, se guarda pero no se publica en el sitio.</span>
            </span>
          </label>
          </div>
        </details>

        <hr class="divider" />

        <div id="ed-body" class="body"></div>

        <p class="ed-hint ed-foot-hint">
          Escribe <kbd>/</kbd> para insertar títulos, listas, tablas, destacados,
          imágenes, vídeos, mapas conceptuales y diagramas de flujo.
          También funcionan los atajos de Markdown: <kbd># </kbd>, <kbd>- </kbd>,
          <kbd>&gt; </kbd>, <kbd>```</kbd>.
        </p>
      </div>
    </main>

    <!-- Barra de formato: se pega encima del teclado mientras se escribe. -->
    <div class="ed-tools" id="ed-tools" role="toolbar" aria-label="Formato" hidden>
      <button class="ed-tool ed-tool-mas" type="button" data-accion="bloques" aria-label="Insertar bloque">+</button>
      <span class="ed-tool-sep" aria-hidden="true"></span>
      <button class="ed-tool" type="button" data-accion="negrita" aria-label="Negrita" aria-pressed="false"><b>B</b></button>
      <button class="ed-tool" type="button" data-accion="cursiva" aria-label="Cursiva" aria-pressed="false"><i>I</i></button>
      <button class="ed-tool" type="button" data-accion="h2" aria-label="Título" aria-pressed="false">H2</button>
      <button class="ed-tool" type="button" data-accion="vinetas" aria-label="Lista con viñetas" aria-pressed="false">•</button>
      <button class="ed-tool" type="button" data-accion="numerada" aria-label="Lista numerada" aria-pressed="false">1.</button>
      <button class="ed-tool" type="button" data-accion="cita" aria-label="Cita" aria-pressed="false">❝</button>
      <button class="ed-tool" type="button" data-accion="enlace" aria-label="Enlace">↗</button>
      <button class="ed-tool" type="button" data-accion="imagen" aria-label="Subir imagen">🖼</button>
      <span class="ed-tool-sep" aria-hidden="true"></span>
      <button class="ed-tool" type="button" data-accion="deshacer" aria-label="Deshacer">↶</button>
      <button class="ed-tool" type="button" data-accion="rehacer" aria-label="Rehacer">↷</button>
    </div>

    <!-- Pestañas inferiores: la navegación de la app en el teléfono. -->
    <nav class="ed-tabs" id="ed-tabs" aria-label="Secciones">
      <button class="ed-tab" type="button" data-vista="escribir" aria-current="page">
        <span class="ed-tab-ico" aria-hidden="true">✎</span><span>Escribir</span>
      </button>
      <button class="ed-tab" type="button" data-vista="entradas">
        <span class="ed-tab-ico" aria-hidden="true">☰</span><span>Entradas</span>
      </button>
      <button class="ed-tab" type="button" data-vista="imagenes">
        <span class="ed-tab-ico" aria-hidden="true">▤</span><span>Imágenes</span>
      </button>
      <button class="ed-tab" type="button" data-vista="ajustes">
        <span class="ed-tab-ico" aria-hidden="true">⚙</span><span>Ajustes</span>
      </button>
    </nav>
  </div>

  <!-- Controles de tabla, visibles solo con el cursor dentro de una -->
  <div class="ed-tabla-bar" id="ed-tabla" hidden>
    <button class="btn" type="button" data-tabla="addRowBefore" title="Insertar fila encima">↑+</button>
    <button class="btn" type="button" data-tabla="addRowAfter" title="Insertar fila debajo">↓+</button>
    <button class="btn" type="button" data-tabla="deleteRow" title="Eliminar la fila">↕−</button>
    <span class="ed-tabla-sep"></span>
    <button class="btn" type="button" data-tabla="addColumnBefore" title="Insertar columna a la izquierda">←+</button>
    <button class="btn" type="button" data-tabla="addColumnAfter" title="Insertar columna a la derecha">→+</button>
    <button class="btn" type="button" data-tabla="deleteColumn" title="Eliminar la columna">↔−</button>
    <span class="ed-tabla-sep"></span>
    <button class="btn" type="button" data-tabla="toggleHeaderRow" title="Poner o quitar el encabezado">Encabezado</button>
    <button class="btn btn-danger" type="button" data-tabla="deleteTable" title="Eliminar la tabla">Borrar</button>
  </div>

  <!-- Menú de barra inclinada -->
  <div class="ed-slash" id="ed-slash" hidden></div>

  <!-- Hoja: en el móvil sube desde abajo; en pantalla ancha es un cuadro centrado. -->
  <div class="ed-hoja" id="ed-hoja" hidden role="dialog" aria-modal="true" aria-labelledby="ed-hoja-titulo">
    <div class="ed-hoja-fondo" id="ed-hoja-fondo"></div>
    <div class="ed-hoja-caja">
      <header class="ed-hoja-top">
        <span class="ed-hoja-asa" aria-hidden="true"></span>
        <h2 id="ed-hoja-titulo" tabindex="-1">Opciones</h2>
        <button class="btn ed-hoja-cerrar" id="ed-hoja-cerrar" type="button" aria-label="Cerrar">✕</button>
      </header>
      <div class="ed-hoja-cuerpo">
      <section class="ed-hoja-seccion" id="ed-bloquespanel" hidden>
        <p class="ed-note">Toca un bloque para insertarlo donde está el cursor.</p>
        <div class="ed-bloques" id="ed-bloques"></div>
      </section>
      <section class="ed-hoja-seccion" id="ed-imagenespanel" hidden>
        <p class="ed-note">
          Cada entrada publicada tiene su carrusel de láminas de 1080×1350, listas
          para descargar o compartir. Se generan al publicarse el sitio.
        </p>
        <div id="ed-imagenes"></div>
      </section>
      <section class="ed-hoja-seccion" id="ed-ajustespanel" hidden>
        <div class="ed-ajustes">
          <button class="ed-ajuste" id="ed-instalar" type="button" hidden>
            <span class="ed-ajuste-nom">Instalar la app</span>
            <span class="ed-ajuste-sub">Queda con su icono y abre a pantalla completa.</span>
          </button>
          <p class="ed-note" id="ed-instalar-ios" hidden>
            <strong>Para instalarla en el iPhone:</strong> pulsa
            <strong>Compartir</strong> en la barra de Safari y luego
            <strong>Añadir a pantalla de inicio</strong>.
          </p>
          <p class="ed-note" id="ed-instalada" hidden>Ya la estás usando como app instalada.</p>
          <button class="ed-ajuste" id="ed-tema" type="button">
            <span class="ed-ajuste-nom">Tema</span>
            <span class="ed-ajuste-sub" id="ed-tema-sub">Claro</span>
          </button>
          <button class="ed-ajuste" id="ed-ir-acceso" type="button">
            <span class="ed-ajuste-nom">Acceso de publicación</span>
            <span class="ed-ajuste-sub" id="ed-acceso-sub">Sin token</span>
          </button>
          <button class="ed-ajuste" id="ed-ir-diagramas" type="button">
            <span class="ed-ajuste-nom">Ver los diagramas dibujados</span>
            <span class="ed-ajuste-sub">Los mapas y flujos de esta entrada.</span>
          </button>
          <a class="ed-ajuste" href={base}>
            <span class="ed-ajuste-nom">Ir al blog</span>
            <span class="ed-ajuste-sub">tonny.blog</span>
          </a>
        </div>
      </section>
      <section class="ed-hoja-seccion" id="ed-listpanel" hidden>
      <p class="ed-note">
        Se leen directamente del repositorio. <strong>Editar</strong> carga la entrada
        aquí para modificarla; al publicar se sobrescribe. <strong>Redes</strong> abre
        el carrusel de imágenes de esa entrada, listo para descargar.
        <strong>Eliminar</strong> la borra del sitio y no se puede deshacer desde aquí.
      </p>
      <div id="ed-posts"></div>
      </section>
      <section class="ed-hoja-seccion" id="ed-diagpanel" hidden>
      <div id="ed-diagramas-out"></div>
      </section>
      <section class="ed-hoja-seccion" id="ed-keypanel" hidden>
      <p class="ed-note">
        Para publicar, el editor escribe el archivo de la entrada en tu repositorio de
        GitHub. Necesita un <strong>token de acceso personal</strong> con permiso de
        contenido sobre <code>tny-me/Blog</code>. Se guarda únicamente en este
        navegador (<code>localStorage</code>) y nunca viaja a otro sitio que no sea
        <code>api.github.com</code>.
      </p>
      <div class="ed-keyrow">
        <input type="password" id="ed-token" placeholder="github_pat_..." autocomplete="off" spellcheck="false" />
        <button class="btn btn-primary" id="ed-save-token" type="button">Guardar</button>
        <button class="btn" id="ed-clear-token" type="button">Borrar</button>
      </div>
      <p class="ed-note" id="ed-keystate"></p>
      <p class="ed-note">
        <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener">
          Crear un token de alcance limitado →
        </a>
        Elige <em>Only select repositories → Blog</em> y en permisos
        <em>Repository permissions → Contents → Read and write</em>.
      </p>
      </section>
      </div>
    </div>
  </div>

  <div class="ed-toast" id="ed-toast" role="status" aria-live="polite" hidden></div>

  <input type="file" id="ed-file" accept="image/*" hidden />
</body>

<style is:global>
  .ed-shell { display: flex; flex-direction: column; min-height: 100vh; }

  .ed-bar {
    position: sticky;
    top: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 1.25rem;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  /* En el telefono los botones se reparten en varias lineas en lugar de
     empujar «Publicar» fuera de la pantalla. */
  .ed-bar .reader-acts {
    flex-wrap: wrap;
    justify-content: flex-end;
    flex-shrink: 1;
    min-width: 0;
  }

  .ed-note { font-size: 0.8125rem; color: var(--muted); line-height: 1.6; max-width: 70ch; margin-bottom: 0.6rem; }
  .ed-note code { font-family: var(--mono); font-size: 0.85em; background: var(--hover); border-radius: 3px; padding: 0.05em 0.3em; }
  .ed-note a { color: var(--blue); }
  .ed-keyrow { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.6rem; }
  .ed-keyrow input {
    flex: 1;
    min-width: 260px;
    font: inherit;
    font-size: 0.875rem;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.35rem 0.6rem;
  }

  .ed-post {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.6rem;
    border-radius: 4px;
    border-bottom: 1px solid var(--border);
  }
  .ed-post:last-child { border-bottom: none; }
  .ed-post:hover { background: var(--hover); }
  .ed-post-main { flex: 1; min-width: 0; }
  .ed-post-title { font-size: 0.875rem; font-weight: 500; }
  .ed-post-meta { font-size: 0.75rem; color: var(--faint); }
  .ed-post-acts { display: flex; gap: 0.3rem; flex-shrink: 0; }
  .btn-danger { color: #EB5757; }
  .btn-danger:hover { background: rgba(235, 87, 87, 0.1); color: #EB5757; }

  .ed-doc { flex: 1; padding: 3rem 3.5rem 8rem; }

  .ed-title {
    width: 100%;
    font: inherit;
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text);
    background: none;
    border: none;
    outline: none;
    margin-bottom: 1.25rem;
  }
  .ed-title::placeholder { color: var(--faint); }

  .ed-props .prop { cursor: text; }
  .ed-props input[type="text"], .ed-props input[type="date"], .ed-props input:not([type]) {
    font: inherit;
    font-size: 0.875rem;
    color: var(--text);
    background: none;
    border: none;
    outline: none;
    width: 100%;
    padding: 0.15rem 0.25rem;
    border-radius: 3px;
  }
  .ed-props input:focus { background: var(--hover); }
  .ed-props input::placeholder { color: var(--faint); }
  .ed-hint { font-size: 0.75rem; color: var(--faint); }
  .ed-foot-hint { margin-top: 2rem; }
  @media (max-width: 820px) { .ed-foot-hint { display: none; } }
  .ed-hint kbd, .ed-foot-hint kbd {
    font-family: var(--mono);
    font-size: 0.9em;
    background: var(--hover);
    border-radius: 3px;
    padding: 0.05em 0.3em;
  }

  /* Lienzo de escritura */
  .ProseMirror { outline: none; min-height: 45vh; }
  .ProseMirror p.is-editor-empty:first-child::before {
    content: attr(data-placeholder);
    color: var(--faint);
    float: left;
    height: 0;
    pointer-events: none;
  }

  /* Menú de la barra inclinada */
  .ed-slash {
    position: fixed;
    z-index: 60;
    width: 260px;
    max-height: 300px;
    overflow-y: auto;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.14);
    padding: 0.3rem;
  }
  .ed-slash-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    text-align: left;
    padding: 0.4rem 0.5rem;
    border-radius: 4px;
    font-size: 0.875rem;
  }
  .ed-slash-item[data-active="true"] { background: var(--hover); }
  .ed-slash-ico {
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 4px;
    font-size: 0.8rem;
    color: var(--muted);
    flex-shrink: 0;
  }
  .ed-slash-sub { font-size: 0.75rem; color: var(--faint); }

  .ed-tabla-bar {
    position: fixed;
    z-index: 55;
    display: flex;
    align-items: center;
    gap: 0.15rem;
    padding: 0.25rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
  }
  .ed-tabla-bar .btn { font-size: 0.75rem; padding: 0.2rem 0.4rem; }

  /* Se lee, no se ve: para lectores de pantalla. */
  .visual-oculto {
    position: absolute;
    width: 1px; height: 1px;
    margin: -1px; padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .ed-tabla-sep { width: 1px; height: 16px; background: var(--border); margin: 0 0.2rem; }

  .ed-toast {
    position: fixed;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%);
    z-index: 70;
    max-width: min(90vw, 520px);
    background: var(--text);
    color: var(--bg);
    font-size: 0.875rem;
    border-radius: 6px;
    padding: 0.6rem 0.9rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }
  .ed-toast a { color: inherit; text-decoration: underline; }


  /* ── Hoja de opciones ──────────────────────────────────── */
  .ed-hoja { position: fixed; inset: 0; z-index: 60; display: flex; }
  .ed-hoja[hidden] { display: none; }
  .ed-hoja-fondo { position: absolute; inset: 0; background: rgba(15, 15, 14, 0.45); }
  .ed-hoja-caja {
    position: relative;
    display: flex;
    flex-direction: column;
    margin: auto;
    width: min(640px, calc(100% - 2rem));
    max-height: min(80vh, 720px);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 24px 60px rgba(15, 15, 14, 0.24);
  }
  .ed-hoja-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.9rem 1rem 0.75rem;
    border-bottom: 1px solid var(--border);
  }
  .ed-hoja-top h2 { font-size: 0.9375rem; font-weight: 600; color: var(--text); }
  .ed-hoja-asa { display: none; }
  .ed-hoja-cerrar { font-size: 1rem; line-height: 1; min-width: 44px; min-height: 44px; }
  .ed-hoja-cuerpo { overflow-y: auto; padding: 1rem; -webkit-overflow-scrolling: touch; }
  .ed-hoja-seccion[hidden] { display: none; }
  .ed-hoja-titulo:focus-visible { outline: 2px solid var(--blue); outline-offset: 4px; }

  /* ── Elegir bloque ─────────────────────────────────────── */
  .ed-bloques { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 0.5rem; }
  .ed-bloque {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 56px;
    padding: 0.6rem 0.7rem;
    text-align: left;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--text);
  }
  .ed-bloque:hover, .ed-bloque:focus-visible { background: var(--hover); }
  .ed-bloque-ico {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 30px; height: 30px;
    border-radius: 6px;
    background: var(--rail);
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .ed-bloque-nom { font-size: 0.875rem; font-weight: 500; }
  .ed-bloque-sub { display: block; font-size: 0.75rem; color: var(--faint); }

  /* ── Ajustes ───────────────────────────────────────────── */
  .ed-ajustes { display: flex; flex-direction: column; gap: 0.4rem; }
  .ed-ajuste {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-height: 56px;
    justify-content: center;
    padding: 0.7rem 0.8rem;
    text-align: left;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--text);
  }
  .ed-ajuste:hover, .ed-ajuste:focus-visible { background: var(--hover); }
  .ed-ajuste-nom { font-size: 0.875rem; font-weight: 500; }
  .ed-ajuste-sub { font-size: 0.75rem; color: var(--faint); }

  /* ── Datos de la entrada, plegables ────────────────────── */
  .ed-plegable { border: 1px solid var(--border); border-radius: 8px; margin-bottom: 1.25rem; }
  .ed-plegable[open] { padding-bottom: 0.4rem; }
  .ed-plegable-tapa {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 48px;
    padding: 0.6rem 0.85rem;
    cursor: pointer;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--muted);
    list-style: none;
  }
  .ed-plegable-tapa::-webkit-details-marker { display: none; }
  .ed-plegable-tapa::after { content: '▾'; color: var(--faint); }
  .ed-plegable[open] .ed-plegable-tapa::after { content: '▴'; }
  .ed-plegable-resumen {
    flex: 1;
    text-align: right;
    font-weight: 400;
    color: var(--faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ed-plegable[open] .ed-plegable-resumen { display: none; }
  .ed-plegable .ed-props { padding: 0 0.85rem; }

  /* ── Barra de formato y pestañas ───────────────────────── */
  .ed-tools {
    position: fixed;
    left: 0; right: 0;
    bottom: var(--ed-teclado, 0px);
    z-index: 40;
    display: flex;
    gap: 0.25rem;
    align-items: center;
    padding: 0.35rem 0.5rem;
    background: var(--bg);
    border-top: 1px solid var(--border);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .ed-tools[hidden] { display: none; }
  .ed-tools::-webkit-scrollbar { display: none; }
  .ed-tool {
    flex-shrink: 0;
    min-width: 44px;
    min-height: 44px;
    border-radius: 8px;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .ed-tool:hover, .ed-tool:focus-visible { background: var(--hover); color: var(--text); }
  .ed-tool[aria-pressed="true"] { background: var(--hover); color: var(--text); }
  .ed-tool-mas { font-size: 1.375rem; color: var(--text); }
  .ed-tool-sep { flex-shrink: 0; width: 1px; height: 22px; background: var(--border); margin: 0 0.15rem; }

  .ed-tabs { display: none; }
  .ed-tab {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    min-height: 52px;
    font-size: 0.6875rem;
    color: var(--faint);
  }
  .ed-tab-ico { font-size: 1.0625rem; line-height: 1; }
  .ed-tab[aria-current="page"] { color: var(--text); }

  /* El foco siempre se ve: se navega con teclado y con lector de pantalla. */
  .ed-tool:focus-visible, .ed-tab:focus-visible, .ed-bloque:focus-visible,
  .ed-ajuste:focus-visible, .ed-plegable-tapa:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .ed-hoja-caja { animation: none !important; }
  }

  @media (max-width: 900px) {
    .ed-doc { padding: 1.75rem 1.25rem 6rem; }
    .ed-title { font-size: 1.875rem; }
    .ed-props .prop { grid-template-columns: 1fr; }
  }

  /* ── Teléfono: la app ──────────────────────────────────── */
  @media (max-width: 820px) {
    .ed-solo-ancho { display: none; }
    .ed-shell { min-height: 100dvh; }
    /* Hueco para la barra de formato, las pestañas y el borde inferior. */
    .ed-doc { padding: 1.25rem 1rem calc(8.5rem + env(safe-area-inset-bottom)); }
    .ed-title { font-size: 1.625rem; }

    .ed-bar { padding: 0.5rem 0.75rem; padding-top: calc(0.5rem + env(safe-area-inset-top)); }
    .ed-bar .btn { min-height: 44px; }
    .ed-volver { min-width: 44px; display: inline-flex; align-items: center; justify-content: center; }

    .ed-tabla-bar { gap: 0.25rem; padding: 0.3rem; max-width: calc(100vw - 1rem); overflow-x: auto; }
    .ed-tabla-bar .btn { min-width: 44px; min-height: 44px; font-size: 0.8125rem; }

    .ed-hoja-caja {
      margin: auto 0 0;
      width: 100%;
      max-height: 88dvh;
      border: none;
      border-top: 1px solid var(--border);
      border-radius: 16px 16px 0 0;
      animation: ed-subir 0.18s ease-out;
    }
    .ed-hoja-top { padding-top: 0.5rem; flex-wrap: wrap; justify-content: center; }
    .ed-hoja-asa {
      display: block;
      width: 100%;
      height: 4px;
      margin-bottom: 0.5rem;
    }
    .ed-hoja-asa::after {
      content: '';
      display: block;
      width: 36px; height: 4px;
      margin: 0 auto;
      border-radius: 99px;
      background: var(--border);
    }
    .ed-hoja-top h2 { flex: 1; }
    .ed-hoja-cuerpo { padding: 1rem 1rem calc(1.25rem + env(safe-area-inset-bottom)); }
    .ed-bloques { grid-template-columns: 1fr 1fr; }

    .ed-tabs {
      position: fixed;
      left: 0; right: 0; bottom: 0;
      z-index: 45;
      display: flex;
      background: var(--bg);
      border-top: 1px solid var(--border);
      padding-bottom: env(safe-area-inset-bottom);
    }
    .ed-tools { bottom: calc(var(--ed-teclado, 0px) + 52px + env(safe-area-inset-bottom)); }

    .ed-hoja[data-modo="vista"] { bottom: calc(52px + env(safe-area-inset-bottom)); }
    .ed-hoja[data-modo="vista"] .ed-hoja-fondo { display: none; }
    .ed-hoja[data-modo="vista"] .ed-hoja-caja {
      margin: 0;
      height: 100%;
      max-height: none;
      border-radius: 0;
      border-top: none;
      animation: none;
    }
    .ed-hoja[data-modo="vista"] .ed-hoja-asa { display: none; }
    /* Las pestañas mandan: siempre por encima de la hoja. */
    .ed-tabs { z-index: 70; }
    /* Con el teclado abierto las pestañas estorban: manda la barra de formato. */
    .ed-shell[data-teclado="si"] .ed-tabs { display: none; }
    .ed-shell[data-teclado="si"] .ed-tools { bottom: var(--ed-teclado, 0px); }
  }

  @keyframes ed-subir {
    from { transform: translateY(12px); opacity: 0.6; }
    to { transform: translateY(0); opacity: 1; }
  }
</style>

<script>
  import { Editor } from '@tiptap/core';
  import StarterKit from '@tiptap/starter-kit';
  import Placeholder from '@tiptap/extension-placeholder';
  import Link from '@tiptap/extension-link';
  import { TableKit } from '@tiptap/extension-table';
  import TurndownService from 'turndown';
  import { gfm } from 'turndown-plugin-gfm';
  import { marked } from 'marked';
  import { Destacado, Figura, Video, urlDeVideo, vistasLocales, PLANTILLA_MAPA, PLANTILLA_FLUJO } from '../lib/editor-blocks';
  import { slugify } from '../lib/slug';

  const REPO = { owner: 'tny-me', name: 'Blog', branch: 'main' };
  const TOKEN_KEY = 'gh_pat';
  const DRAFT_KEY = 'editor_draft';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const els = {
    crumb: $('ed-crumb'),
    state: $('ed-state'),
    keyBtn: $('ed-key'),
    keyPanel: $('ed-keypanel'),
    keyState: $('ed-keystate'),
    token: $<HTMLInputElement>('ed-token'),
    publish: $<HTMLButtonElement>('ed-publish'),
    titulo: $<HTMLInputElement>('ed-titulo'),
    fecha: $<HTMLInputElement>('ed-fecha'),
    categoria: $<HTMLInputElement>('ed-categoria'),
    tags: $<HTMLInputElement>('ed-tags'),
    desc: $<HTMLInputElement>('ed-desc'),
    draft: $<HTMLInputElement>('ed-draft'),
    listBtn: $('ed-list'),
    listPanel: $('ed-listpanel'),
    posts: $('ed-posts'),
    slash: $('ed-slash'),
    toast: $('ed-toast'),
    file: $<HTMLInputElement>('ed-file'),
  };

  // ── Avisos ────────────────────────────────────────────────
  let toastTimer: number | undefined;
  function toast(html: string, ms = 5000) {
    els.toast.innerHTML = html;
    els.toast.hidden = false;
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => { els.toast.hidden = true; }, ms);
  }

  // ── Token ─────────────────────────────────────────────────
  const getToken = () => localStorage.getItem(TOKEN_KEY) ?? '';

  function paintKeyState() {
    const has = !!getToken();
    els.keyState.textContent = has
      ? 'Hay un token guardado en este navegador.'
      : 'Sin token: puedes escribir y guardar el borrador, pero no publicar.';
    els.keyBtn.textContent = has ? 'Acceso ✓' : 'Acceso';
  }

  els.keyBtn.addEventListener('click', () => abrirHoja('acceso'));

  $('ed-save-token').addEventListener('click', () => {
    const value = els.token.value.trim();
    if (!value) return;
    localStorage.setItem(TOKEN_KEY, value);
    els.token.value = '';
    paintKeyState();
    toast('Token guardado en este navegador.');
  });

  $('ed-clear-token').addEventListener('click', () => {
    localStorage.removeItem(TOKEN_KEY);
    paintKeyState();
    toast('Token borrado de este navegador.');
  });

  paintKeyState();

  // ── Editor ────────────────────────────────────────────────
  const editor = new Editor({
    element: $('ed-body'),
    extensions: [
      StarterKit.configure({ heading: { levels: [1, 2, 3] } }),
      TableKit.configure({ table: { resizable: false } }),
      Destacado,
      Figura,
      Video,
      Link.configure({ openOnClick: false }),
      Placeholder.configure({
        placeholder: () => (window.matchMedia('(max-width: 820px)').matches
          ? 'Escribe, o toca + para insertar un bloque…'
          : 'Escribe, o pulsa "/" para insertar un bloque…'),
      }),
    ],
    content: '<p></p>',
    onUpdate: () => { saveDraft(); refreshSlash(); },
    onSelectionUpdate: () => refreshSlash(),
  });

  // ── Borrador local ────────────────────────────────────────
  let saveTimer: number | undefined;
  function saveDraft() {
    clearTimeout(saveTimer);
    saveTimer = window.setTimeout(() => {
      localStorage.setItem(DRAFT_KEY, JSON.stringify({
        titulo: els.titulo.value,
        fecha: els.fecha.value,
        categoria: els.categoria.value,
        tags: els.tags.value,
        desc: els.desc.value,
        draft: els.draft.checked,
        html: editor.getHTML(),
      }));
      els.state.textContent = 'Borrador guardado';
      els.crumb.textContent = els.titulo.value.trim() || 'Entrada sin título';
    }, 400);
  }

  function loadDraft() {
    const raw = localStorage.getItem(DRAFT_KEY);
    if (!raw) return;
    try {
      const d = JSON.parse(raw);
      els.titulo.value = d.titulo ?? '';
      if (d.fecha) els.fecha.value = d.fecha;
      els.categoria.value = d.categoria ?? '';
      els.tags.value = d.tags ?? '';
      els.desc.value = d.desc ?? '';
      els.draft.checked = !!d.draft;
      if (d.html) editor.commands.setContent(d.html);
      els.crumb.textContent = els.titulo.value.trim() || 'Entrada sin título';
      els.state.textContent = 'Borrador recuperado';
    } catch {
      /* borrador ilegible: se ignora y se empieza en limpio */
    }
  }

  [els.titulo, els.fecha, els.categoria, els.tags, els.desc, els.draft]
    .forEach((el) => el.addEventListener('input', saveDraft));

  els.titulo.addEventListener('input', () => {
    els.crumb.textContent = els.titulo.value.trim() || 'Entrada sin título';
  });

  loadDraft();

  // ── Menú de la barra inclinada ────────────────────────────
  type Cmd = { key: string; label: string; sub: string; ico: string; run: () => void };

  const chain = () => editor.chain().focus();

  const COMMANDS: Cmd[] = [
    { key: 'texto parrafo', label: 'Texto', sub: 'Párrafo normal', ico: '¶', run: () => chain().setParagraph().run() },
    { key: 'titulo 1 h1 encabezado', label: 'Título 1', sub: 'Sección grande', ico: 'H1', run: () => chain().toggleHeading({ level: 1 }).run() },
    { key: 'titulo 2 h2 encabezado', label: 'Título 2', sub: 'Sección mediana', ico: 'H2', run: () => chain().toggleHeading({ level: 2 }).run() },
    { key: 'titulo 3 h3 encabezado', label: 'Título 3', sub: 'Sección pequeña', ico: 'H3', run: () => chain().toggleHeading({ level: 3 }).run() },
    { key: 'lista vinetas bullet', label: 'Lista con viñetas', sub: 'Puntos sueltos', ico: '•', run: () => chain().toggleBulletList().run() },
    { key: 'lista numerada orden', label: 'Lista numerada', sub: 'Pasos en orden', ico: '1.', run: () => chain().toggleOrderedList().run() },
    { key: 'cita quote', label: 'Cita', sub: 'Texto destacado', ico: '❝', run: () => chain().toggleBlockquote().run() },
    { key: 'codigo code bloque', label: 'Código', sub: 'Bloque monoespaciado', ico: '{}', run: () => chain().toggleCodeBlock().run() },
    { key: 'divisor separador linea', label: 'Divisor', sub: 'Línea horizontal', ico: '—', run: () => chain().setHorizontalRule().run() },
    { key: 'imagen foto subir', label: 'Imagen', sub: 'Subir con pie de foto', ico: '🖼', run: () => els.file.click() },
    { key: 'enlace link url', label: 'Enlace', sub: 'Añadir una liga', ico: '↗', run: promptLink },
    { key: 'tabla cuadro filas columnas', label: 'Tabla', sub: '3 columnas con encabezado', ico: '▦',
      run: () => chain().insertTable({ rows: 3, cols: 3, withHeaderRow: true }).run() },
    { key: 'destacado nota callout informacion azul', label: 'Destacado · Nota', sub: 'Recuadro azul', ico: '🔵',
      run: () => (chain() as any).ponerDestacado('nota').run() },
    { key: 'destacado idea callout consejo', label: 'Destacado · Idea', sub: 'Recuadro ámbar', ico: '🟡',
      run: () => (chain() as any).ponerDestacado('idea').run() },
    { key: 'destacado aviso alerta advertencia cuidado', label: 'Destacado · Aviso', sub: 'Recuadro rojo', ico: '🔴',
      run: () => (chain() as any).ponerDestacado('aviso').run() },
    { key: 'mapa conceptual mental esquema ideas', label: 'Mapa conceptual', sub: 'Ramas desde un tema central', ico: '🕸',
      run: () => insertarDiagrama(PLANTILLA_MAPA) },
    { key: 'diagrama flujo proceso pasos decision', label: 'Diagrama de flujo', sub: 'Pasos y decisiones', ico: '⤳',
      run: () => insertarDiagrama(PLANTILLA_FLUJO) },
    { key: 'video youtube vimeo incrustar', label: 'Vídeo', sub: 'YouTube o Vimeo', ico: '▶', run: promptVideo },
  ];

  /** Los diagramas viajan como bloque de código en lenguaje mermaid. */
  function insertarDiagrama(plantilla: string) {
    editor.chain().focus()
      .insertContent({
        type: 'codeBlock',
        attrs: { language: 'mermaid' },
        content: [{ type: 'text', text: plantilla }],
      })
      .run();
    toast('Diagrama insertado. Pulsa «Diagramas» arriba para verlo dibujado.', 7000);
  }

  function promptVideo() {
    const pegado = window.prompt('Pega la dirección del vídeo (YouTube o Vimeo)');
    if (!pegado) return;
    const src = urlDeVideo(pegado);
    if (!src) return toast('No reconocí esa dirección. Deben ser de YouTube o Vimeo.', 8000);
    (editor.chain().focus() as any).ponerVideo(src).run();
  }

  let slashOpen = false;
  let slashFrom = 0;
  let slashItems: Cmd[] = [];
  let slashIndex = 0;

  /** Texto escrito tras la barra inclinada, si el cursor sigue dentro de ella. */
  function slashQuery(): { from: number; query: string } | null {
    const { state } = editor;
    const { from, empty } = state.selection;
    if (!empty) return null;
    const start = state.doc.resolve(from).start();
    const text = state.doc.textBetween(start, from, '\n', '\0');
    const match = /\/([\p{L}\p{N} ]{0,24})$/u.exec(text);
    if (!match) return null;
    return { from: from - match[0].length, query: match[1].trim().toLowerCase() };
  }

  const norm = (s: string) =>
    s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

  function refreshSlash() {
    const hit = slashQuery();
    if (!hit) return closeSlash();

    const q = norm(hit.query);
    slashItems = q
      ? COMMANDS.filter((c) => norm(c.key + ' ' + c.label).includes(q))
      : COMMANDS;

    if (slashItems.length === 0) return closeSlash();

    slashFrom = hit.from;
    slashIndex = 0;
    slashOpen = true;
    paintSlash();
  }

  function paintSlash() {
    els.slash.innerHTML = '';
    slashItems.forEach((cmd, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'ed-slash-item';
      b.dataset.active = String(i === slashIndex);
      b.innerHTML =
        `<span class="ed-slash-ico">${cmd.ico}</span>` +
        `<span><span>${cmd.label}</span><br><span class="ed-slash-sub">${cmd.sub}</span></span>`;
      b.addEventListener('mousedown', (e) => { e.preventDefault(); pick(i); });
      els.slash.appendChild(b);
    });

    const coords = editor.view.coordsAtPos(editor.state.selection.from);
    const top = Math.min(coords.bottom + 6, window.innerHeight - 320);
    els.slash.style.left = `${Math.min(coords.left, window.innerWidth - 280)}px`;
    els.slash.style.top = `${Math.max(top, 8)}px`;
    els.slash.hidden = false;
  }

  function closeSlash() {
    slashOpen = false;
    els.slash.hidden = true;
  }

  function pick(i: number) {
    const cmd = slashItems[i];
    if (!cmd) return;
    editor.chain().focus().deleteRange({ from: slashFrom, to: editor.state.selection.from }).run();
    closeSlash();
    cmd.run();
  }

  editor.view.dom.addEventListener('keydown', (e: KeyboardEvent) => {
    if (!slashOpen) return;
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      slashIndex = (slashIndex + 1) % slashItems.length;
      paintSlash();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      slashIndex = (slashIndex - 1 + slashItems.length) % slashItems.length;
      paintSlash();
    } else if (e.key === 'Enter' || e.key === 'Tab') {
      e.preventDefault();
      pick(slashIndex);
    } else if (e.key === 'Escape') {
      e.preventDefault();
      closeSlash();
    }
  }, true);

  function promptLink() {
    const url = window.prompt('Dirección del enlace');
    if (url) chain().setLink({ href: url }).run();
  }

  // ── Imágenes ──────────────────────────────────────────────
  els.file.addEventListener('change', async () => {
    const file = els.file.files?.[0];
    els.file.value = '';
    if (!file) return;
    if (!getToken()) return toast('Para subir imágenes hace falta guardar un token en «Acceso».');

    const name = `${Date.now()}-${slugify(file.name.replace(/\.[^.]+$/, ''))}.${(file.name.split('.').pop() ?? 'png').toLowerCase()}`;
    const path = `public/assets/img/${name}`;
    toast('Subiendo imagen…', 20000);
    try {
      const b64 = await fileToBase64(file);
      await putFile(path, b64, `Subir imagen ${name}`);

      const destino = `/assets/img/${name}`;
      // Se ve al instante, aunque el sitio tarde un minuto en publicarla.
      vistasLocales.set(destino, URL.createObjectURL(file));

      // Sin texto de relleno en el pie: se deja vacio, con su indicacion, y el
      // cursor dentro para escribirlo directamente.
      (chain() as any).ponerFigura({ src: destino }).run();
      ponerCursorEnPie();
      toast('Imagen subida. Escribe el pie de foto, o déjalo vacío.', 7000);
    } catch (err) {
      toast(`No se pudo subir la imagen: ${(err as Error).message}`, 9000);
    }
  });

  /** Deja el cursor dentro del pie de la ultima figura insertada. */
  function ponerCursorEnPie() {
    let posicion: number | null = null;
    editor.state.doc.descendants((nodo, pos) => {
      if (nodo.type.name === 'figura') posicion = pos + 1;
    });
    if (posicion !== null) editor.chain().focus().setTextSelection(posicion).run();
  }

  function fileToBase64(file: File): Promise<string> {
    return new Promise((resolve, reject) => {
      const r = new FileReader();
      r.onload = () => resolve(String(r.result).split(',')[1]);
      r.onerror = () => reject(new Error('no se pudo leer el archivo'));
      r.readAsDataURL(file);
    });
  }

  // ── Publicación ───────────────────────────────────────────
  const turndown = new TurndownService({
    headingStyle: 'atx',
    codeBlockStyle: 'fenced',
    bulletListMarker: '-',
    emDelimiter: '*',
  });

  // Tablas al formato de Markdown extendido, que Astro ya sabe renderizar.
  turndown.use(gfm);

  // Los bloques propios no tienen equivalente en Markdown: se guardan como el
  // HTML que Astro renderizará, sin que turndown los desarme.
  turndown.addRule('bloquesPropios', {
    filter: (node) =>
      ['ASIDE', 'FIGURE', 'DIV'].includes(node.nodeName) &&
      /\b(destacado|figura|video)\b/.test((node as HTMLElement).className ?? ''),
    replacement: (_contenido, node) => `\n\n${(node as HTMLElement).outerHTML}\n\n`,
  });

  // El editor envuelve el contenido de cada <li> en un <p>, y eso produce listas
  // sueltas con un renglon en blanco entre puntos. Se quitan esos envoltorios.
  function tightHtml(html: string): string {
    const doc = new DOMParser().parseFromString(html, 'text/html');
    // El editor envuelve el contenido de listas y celdas en parrafos. Dentro de
    // una celda eso parte la fila en varias lineas y rompe la tabla.
    doc.querySelectorAll('li > p:only-child, th > p:only-child, td > p:only-child').forEach((p) => {
      p.replaceWith(...Array.from(p.childNodes));
    });

    // El editor decora las tablas con medidas y atributos que no aportan nada
    // al archivo publicado y estorban a la conversion a Markdown.
    doc.querySelectorAll('table colgroup').forEach((c) => c.remove());
    doc.querySelectorAll('table [style], table[style]').forEach((e) => e.removeAttribute('style'));
    doc.querySelectorAll('[colspan="1"]').forEach((e) => e.removeAttribute('colspan'));
    doc.querySelectorAll('[rowspan="1"]').forEach((e) => e.removeAttribute('rowspan'));

    // Filas totalmente vacias al final de una tabla: no aportan nada.
    doc.querySelectorAll('table tr').forEach((tr) => {
      if (![...tr.children].some((c) => (c.textContent ?? '').trim())) tr.remove();
    });

    return doc.body.innerHTML;
  }

  // Vineta con un solo espacio, en lugar de los tres que pone turndown por defecto.
  turndown.addRule('listItemCompacto', {
    filter: 'li',
    replacement: (content, node) => {
      const texto = content.replace(/^\n+/, '').replace(/\n+$/, '').replace(/\n/g, '\n  ');
      const padre = node.parentNode as HTMLElement;
      let marca = '- ';
      if (padre?.nodeName === 'OL') {
        const inicio = Number(padre.getAttribute('start') ?? 1);
        marca = `${inicio + Array.prototype.indexOf.call(padre.children, node)}. `;
      }
      return `${marca}${texto}\n`;
    },
  });

  /** Base64 seguro para texto con acentos. */
  function toBase64(text: string): string {
    const bytes = new TextEncoder().encode(text);
    let bin = '';
    bytes.forEach((b) => { bin += String.fromCharCode(b); });
    return btoa(bin);
  }

  async function gh(path: string, init?: RequestInit) {
    const res = await fetch(`https://api.github.com/repos/${REPO.owner}/${REPO.name}/${path}`, {
      ...init,
      headers: {
        Accept: 'application/vnd.github+json',
        Authorization: `Bearer ${getToken()}`,
        'X-GitHub-Api-Version': '2022-11-28',
        ...(init?.headers ?? {}),
      },
    });
    return res;
  }

  async function putFile(path: string, contentB64: string, message: string) {
    // Si el archivo ya existe hace falta su sha para sobrescribirlo.
    let sha: string | undefined;
    const probe = await gh(`contents/${path}?ref=${REPO.branch}`);
    if (probe.ok) sha = (await probe.json()).sha;
    else if (probe.status !== 404) throw new Error(await ghError(probe));

    const res = await gh(`contents/${path}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message, content: contentB64, branch: REPO.branch, sha }),
    });
    if (!res.ok) throw new Error(await ghError(res));
    return res.json();
  }

  async function ghError(res: Response) {
    let detail = '';
    try { detail = (await res.json()).message ?? ''; } catch { /* respuesta sin cuerpo JSON */ }
    if (res.status === 401) return 'el token no es válido o caducó (401)';
    if (res.status === 403) return `sin permiso sobre el repositorio (403) ${detail}`;
    if (res.status === 404) return 'no se encontró el repositorio o el token no lo alcanza (404)';
    return `${res.status} ${detail}`;
  }

  function frontmatter(): string {
    const esc = (s: string) => s.replace(/"/g, '\\"');
    const tags = els.tags.value.split(',').map((t) => t.trim()).filter(Boolean);
    const lines = [
      '---',
      `title: "${esc(els.titulo.value.trim())}"`,
      `date: ${els.fecha.value}`,
      `category: "${esc(els.categoria.value.trim() || 'General')}"`,
    ];
    if (els.desc.value.trim()) lines.push(`description: "${esc(els.desc.value.trim())}"`);
    if (tags.length) lines.push(`tags: [${tags.map((t) => `"${esc(t)}"`).join(', ')}]`);
    if (els.draft.checked) lines.push('draft: true');
    lines.push('---', '', '');
    return lines.join('\n');
  }

  // ── Entradas publicadas: listar, editar, eliminar ─────────
  const DIR = 'src/content/posts';

  /** Ruta de la entrada que se esta editando, si se cargo una existente. */
  let editingPath: string | null = null;

  function fromBase64(b64: string): string {
    const bin = atob(b64.replace(/\s/g, ''));
    return new TextDecoder().decode(Uint8Array.from(bin, (c) => c.charCodeAt(0)));
  }

  /** Lector del frontmatter, acotado a los campos que escribe este editor. */
  function parseFrontmatter(md: string): { data: Record<string, any>; body: string } {
    const m = /^---\r?\n([\s\S]*?)\r?\n---\r?\n?/.exec(md);
    if (!m) return { data: {}, body: md };
    const data: Record<string, any> = {};
    for (const linea of m[1].split(/\r?\n/)) {
      const par = /^([A-Za-z_]+):\s*(.*)$/.exec(linea);
      if (!par) continue;
      const valor = par[2].trim();
      if (valor.startsWith('[') && valor.endsWith(']')) {
        data[par[1]] = valor.slice(1, -1).split(',')
          .map((x) => x.trim().replace(/^["']|["']$/g, ''))
          .filter(Boolean);
      } else {
        data[par[1]] = valor.replace(/^["']|["']$/g, '').replace(/\\"/g, '"');
      }
    }
    return { data, body: md.slice(m[0].length) };
  }

  async function deleteByPath(path: string, message: string) {
    const probe = await gh(`contents/${path}?ref=${REPO.branch}`);
    if (!probe.ok) throw new Error(await ghError(probe));
    const sha = (await probe.json()).sha;
    const res = await gh(`contents/${path}`, {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message, sha, branch: REPO.branch }),
    });
    if (!res.ok) throw new Error(await ghError(res));
  }

  async function cargarEntradas(destino = els.posts, modo: 'gestion' | 'imagenes' = 'gestion') {
    if (!getToken()) {
      destino.innerHTML = '<p class="ed-note">Guarda un token en «Acceso» para ver tus entradas.</p>';
      return;
    }
    destino.innerHTML = '<p class="ed-note">Cargando…</p>';
    try {
      const res = await gh(`contents/${DIR}?ref=${REPO.branch}`);
      if (!res.ok) throw new Error(await ghError(res));
      const archivos = (await res.json()).filter((f: any) => f.name.endsWith('.md'));

      const entradas = await Promise.all(archivos.map(async (f: any) => {
        const uno = await gh(`contents/${f.path}?ref=${REPO.branch}`);
        const md = uno.ok ? fromBase64((await uno.json()).content) : '';
        const { data } = parseFrontmatter(md);
        return { path: f.path, name: f.name, data };
      }));

      entradas.sort((a, b) => String(b.data.date ?? '').localeCompare(String(a.data.date ?? '')));
      if (modo === 'imagenes') pintarImagenes(entradas, destino);
      else pintarEntradas(entradas);
    } catch (err) {
      destino.innerHTML = `<p class="ed-note">No se pudieron cargar: ${(err as Error).message}</p>`;
    }
  }

  /** Listado escueto: cada entrada con su enlace al carrusel de láminas. */
  function pintarImagenes(entradas: Array<{ name: string; data: any }>, destino: HTMLElement) {
    destino.innerHTML = '';
    if (entradas.length === 0) {
      destino.innerHTML = '<p class="ed-note">No hay entradas todavía.</p>';
      return;
    }
    for (const entrada of entradas) {
      const slug = entrada.name.replace(/\.md$/, '');
      const fila = document.createElement('a');
      fila.className = 'ed-ajuste';
      fila.href = `/redes/${slug}/`;
      fila.innerHTML =
        `<span class="ed-ajuste-nom"></span>` +
        `<span class="ed-ajuste-sub"></span>`;
      (fila.firstElementChild as HTMLElement).textContent = entrada.data.title ?? slug;
      (fila.lastElementChild as HTMLElement).textContent =
        [entrada.data.date, entrada.data.category].filter(Boolean).join(' · ') + ' · Ver láminas →';
      destino.appendChild(fila);
    }
  }

  function pintarEntradas(entradas: Array<{ path: string; name: string; data: any }>) {
    els.posts.innerHTML = '';
    if (entradas.length === 0) {
      els.posts.innerHTML = '<p class="ed-note">No hay entradas todavía.</p>';
      return;
    }
    for (const entrada of entradas) {
      const fila = document.createElement('div');
      fila.className = 'ed-post';

      const main = document.createElement('div');
      main.className = 'ed-post-main';
      const titulo = document.createElement('div');
      titulo.className = 'ed-post-title';
      titulo.textContent = entrada.data.title ?? entrada.name;
      const meta = document.createElement('div');
      meta.className = 'ed-post-meta';
      meta.textContent = [
        entrada.data.date,
        entrada.data.category,
        entrada.data.draft === 'true' || entrada.data.draft === true ? 'borrador' : null,
      ].filter(Boolean).join(' · ');
      main.append(titulo, meta);

      const acts = document.createElement('div');
      acts.className = 'ed-post-acts';

      const ver = document.createElement('a');
      ver.className = 'btn';
      ver.textContent = 'Ver';
      ver.target = '_blank';
      ver.rel = 'noopener';
      ver.href = `/posts/${entrada.name.replace(/\.md$/, '')}`;

      const redes = document.createElement('a');
      redes.className = 'btn';
      redes.textContent = 'Redes';
      redes.title = 'Carrusel de imágenes para redes sociales';
      redes.target = '_blank';
      redes.rel = 'noopener';
      redes.href = `/redes/${entrada.name.replace(/\.md$/, '')}/`;

      const editar = document.createElement('button');
      editar.className = 'btn';
      editar.type = 'button';
      editar.textContent = 'Editar';
      editar.addEventListener('click', () => abrirEntrada(entrada.path));

      const borrar = document.createElement('button');
      borrar.className = 'btn btn-danger';
      borrar.type = 'button';
      borrar.textContent = 'Eliminar';
      borrar.addEventListener('click', () => borrarEntrada(entrada.path, titulo.textContent ?? ''));

      acts.append(ver, redes, editar, borrar);
      fila.append(main, acts);
      els.posts.appendChild(fila);
    }
  }

  async function abrirEntrada(path: string) {
    try {
      const res = await gh(`contents/${path}?ref=${REPO.branch}`);
      if (!res.ok) throw new Error(await ghError(res));
      const { data, body } = parseFrontmatter(fromBase64((await res.json()).content));

      els.titulo.value = data.title ?? '';
      if (data.date) els.fecha.value = String(data.date).slice(0, 10);
      els.categoria.value = data.category ?? '';
      els.tags.value = Array.isArray(data.tags) ? data.tags.join(', ') : (data.tags ?? '');
      els.desc.value = data.description ?? '';
      els.draft.checked = data.draft === true || data.draft === 'true';
      editor.commands.setContent(await marked.parse(body));

      editingPath = path;
      els.crumb.textContent = els.titulo.value || path;
      els.state.textContent = 'Editando publicada';
      cerrarHoja();
      saveDraft();
      window.scrollTo({ top: 0, behavior: 'smooth' });
      toast('Entrada cargada. Al publicar se sobrescribe.');
    } catch (err) {
      toast(`No se pudo abrir: ${(err as Error).message}`, 9000);
    }
  }

  async function borrarEntrada(path: string, titulo: string) {
    if (!window.confirm(`¿Eliminar «${titulo}»? Desaparecerá del sitio y no se puede deshacer desde aquí.`)) return;
    try {
      await deleteByPath(path, `Eliminar entrada: ${titulo}`);
      if (editingPath === path) nuevaEntrada();
      toast('Entrada eliminada. El sitio se actualiza en un minuto.');
      cargarEntradas();
    } catch (err) {
      toast(`No se pudo eliminar: ${(err as Error).message}`, 9000);
    }
  }

  function nuevaEntrada() {
    editingPath = null;
    els.titulo.value = '';
    els.categoria.value = '';
    els.tags.value = '';
    els.desc.value = '';
    els.draft.checked = false;
    els.fecha.value = new Date().toISOString().slice(0, 10);
    editor.commands.setContent('<p></p>');
    els.crumb.textContent = 'Entrada sin título';
    els.state.textContent = 'Borrador local';
    localStorage.removeItem(DRAFT_KEY);
    els.titulo.focus();
  }

  // ── Controles de tabla ────────────────────────────────────
  const barraTabla = $('ed-tabla');

  barraTabla.addEventListener('mousedown', (e) => {
    const boton = (e.target as HTMLElement).closest('[data-tabla]');
    if (!boton) return;
    e.preventDefault();   // no perder el cursor dentro de la celda
    const accion = boton.getAttribute('data-tabla')!;
    (editor.chain().focus() as any)[accion]().run();
    setTimeout(situarBarraTabla, 0);
  });

  function situarBarraTabla() {
    if (!editor.isActive('table')) {
      barraTabla.hidden = true;
      return;
    }
    const nodo = editor.view.domAtPos(editor.state.selection.from).node;
    const elemento = (nodo.nodeType === 1 ? nodo : nodo.parentElement) as HTMLElement | null;
    const tabla = elemento?.closest('table');
    if (!tabla) {
      barraTabla.hidden = true;
      return;
    }
    const caja = tabla.getBoundingClientRect();
    barraTabla.hidden = false;
    const alto = barraTabla.offsetHeight;
    // Debajo de la tabla si arriba no cabe.
    const arriba = caja.top - alto - 8;
    barraTabla.style.top = `${arriba > 60 ? arriba : caja.bottom + 8}px`;
    barraTabla.style.left = `${Math.max(8, caja.left)}px`;
  }

  editor.on('selectionUpdate', situarBarraTabla);
  editor.on('transaction', situarBarraTabla);
  // Al pinchar fuera del texto la barra deja de tener sentido. Los botones
  // conservan el foco (evitan el mousedown), asi que esto no los estorba.
  editor.on('blur', () => { barraTabla.hidden = true; });
  window.addEventListener('scroll', situarBarraTabla, true);
  window.addEventListener('resize', situarBarraTabla);

  // ── Vista previa de los diagramas ─────────────────────────
  const salidaDiag = $('ed-diagramas-out');

  async function dibujarDiagramas() {
    const codigos: string[] = [];
    editor.state.doc.descendants((nodo) => {
      if (nodo.type.name === 'codeBlock' && nodo.attrs.language === 'mermaid') {
        codigos.push(nodo.textContent);
      }
    });

    if (codigos.length === 0) {
      salidaDiag.innerHTML = '<p class="ed-note">Esta entrada no tiene diagramas. Inserta uno con «/».</p>';
      return;
    }

    salidaDiag.innerHTML = '<p class="ed-note">Dibujando…</p>';
    const { default: mermaid } = await import('mermaid');
    const { configuracionMermaid } = await import('../lib/diagramas');
    mermaid.initialize(
      configuracionMermaid(document.documentElement.getAttribute('data-theme') === 'dark')
    );

    salidaDiag.innerHTML = '';
    for (const [i, codigo] of codigos.entries()) {
      const caja = document.createElement('div');
      caja.className = 'diagrama';
      try {
        const { svg } = await mermaid.render(`vista-${i}-${codigos.length}`, codigo);
        caja.innerHTML = svg;
      } catch (err) {
        caja.innerHTML = `<p class="ed-note">Diagrama ${i + 1}: ${(err as Error).message}</p>`;
      }
      salidaDiag.appendChild(caja);
    }
  }

  $('ed-diagramas').addEventListener('click', () => {
    abrirHoja('diagramas');
    dibujarDiagramas();
  });

  els.listBtn.addEventListener('click', () => abrirHoja('entradas'));

  // El carrusel se dibuja a partir de la entrada ya publicada, no del borrador
  // que hay en pantalla: por eso hace falta haberla guardado antes.
  $('ed-redes').addEventListener('click', () => {
    const titulo = els.titulo.value.trim();
    if (!titulo) return toast('Ponle un título y publica la entrada: las imágenes se hacen con lo publicado.');
    if (editingPath === null) {
      return toast('Publica la entrada primero. Las imágenes para redes se generan al publicarse el sitio.', 8000);
    }
    window.open(`/redes/${slugify(titulo)}/`, '_blank', 'noopener');
  });

  $('ed-new').addEventListener('click', () => {
    if (els.titulo.value.trim() && !window.confirm('Se descartará lo que tienes en pantalla. ¿Seguir?')) return;
    nuevaEntrada();
  });

  els.publish.addEventListener('click', async () => {
    const titulo = els.titulo.value.trim();
    if (!titulo) return toast('Ponle un título a la entrada antes de publicar.');
    if (!getToken()) {
      abrirHoja('acceso');
      return toast('Guarda primero un token en «Acceso».');
    }

    const slug = slugify(titulo);
    const path = `src/content/posts/${slug}.md`;
    const markdown = frontmatter() + turndown.turndown(tightHtml(editor.getHTML())).trim() + '\n';

    els.publish.disabled = true;
    els.publish.textContent = 'Publicando…';
    try {
      const editando = editingPath !== null;
      await putFile(path, toBase64(markdown), `${editando ? 'Actualizar' : 'Publicar'} entrada: ${titulo}`);

      // Si al editar cambio el titulo, cambia la ruta: se retira la anterior.
      let renombrada = false;
      if (editingPath && editingPath !== path) {
        await deleteByPath(editingPath, `Retirar ruta anterior de: ${titulo}`);
        renombrada = true;
      }
      editingPath = path;

      const url = els.draft.checked ? null : `https://tonny.blog/posts/${slug}`;
      els.state.textContent = editando ? 'Actualizada' : 'Publicado';
      toast(
        url
          ? `Entrada guardada.${renombrada ? ' Cambió el título, así que su dirección también.' : ''} ` +
            `En un par de minutos estará en <a href="${url}" target="_blank" rel="noopener">${url}</a>, ` +
            `y sus <a href="/redes/${slug}/" target="_blank" rel="noopener">imágenes para redes</a> ` +
            `se generan a la vez.`
          : 'Entrada guardada como borrador: no aparecerá en el sitio hasta que desmarques «Borrador».',
        15000
      );
    } catch (err) {
      toast(`No se pudo publicar: ${(err as Error).message}`, 10000);
    } finally {
      els.publish.disabled = false;
      els.publish.textContent = 'Publicar';
    }
  });
  // ══ La app en el teléfono ═══════════════════════════════════
  //
  // Todo lo que sigue convierte el editor en algo usable con el pulgar: una
  // hoja para las opciones, pestañas abajo, una barra de formato que se pega
  // encima del teclado, y el envoltorio para instalarla en la pantalla de
  // inicio. En pantalla ancha nada de esto estorba: las pestañas y la barra
  // se ocultan por CSS y la hoja se dibuja como un cuadro centrado.

  const shell = document.querySelector('.ed-shell') as HTMLElement;
  const hoja = $('ed-hoja');
  const hojaTitulo = $('ed-hoja-titulo');
  const hojaCaja = hoja.querySelector('.ed-hoja-caja') as HTMLElement;

  const SECCIONES: Record<string, { id: string; titulo: string; alAbrir?: () => void }> = {
    bloques: { id: 'ed-bloquespanel', titulo: 'Insertar' },
    entradas: { id: 'ed-listpanel', titulo: 'Mis entradas', alAbrir: () => cargarEntradas() },
    imagenes: {
      id: 'ed-imagenespanel', titulo: 'Imágenes para redes',
      alAbrir: () => cargarEntradas($('ed-imagenes'), 'imagenes'),
    },
    ajustes: { id: 'ed-ajustespanel', titulo: 'Ajustes', alAbrir: pintarAjustes },
    diagramas: { id: 'ed-diagpanel', titulo: 'Diagramas' },
    acceso: { id: 'ed-keypanel', titulo: 'Acceso de publicación', alAbrir: paintKeyState },
  };

  let focoPrevio: HTMLElement | null = null;
  let hojaAbierta: string | null = null;
  let hojaModal = false;

  function abrirHoja(nombre: string, modo: 'vista' | 'modal' = 'modal') {
    const seccion = SECCIONES[nombre];
    if (!seccion) return;

    focoPrevio = document.activeElement as HTMLElement;
    hojaAbierta = nombre;
    hojaModal = modo === 'modal';
    hoja.dataset.modo = modo;
    hojaTitulo.textContent = seccion.titulo;
    for (const clave of Object.keys(SECCIONES)) {
      $(SECCIONES[clave].id).hidden = clave !== nombre;
    }
    hoja.hidden = false;

    // Un modal tapa lo de detrás; una vista convive con las pestañas.
    if (hojaModal) {
      hoja.setAttribute('aria-modal', 'true');
      shell.setAttribute('aria-hidden', 'true');
    } else {
      hoja.removeAttribute('aria-modal');
      shell.removeAttribute('aria-hidden');
    }
    document.body.style.overflow = 'hidden';
    marcarPestana(nombre);
    seccion.alAbrir?.();

    // El foco entra en la hoja: si no, el lector de pantalla se queda detrás.
    (hojaModal ? ($('ed-hoja-cerrar') as HTMLButtonElement) : hojaTitulo).focus();
  }

  function cerrarHoja() {
    if (hoja.hidden) return;
    hoja.hidden = true;
    hoja.removeAttribute('aria-modal');
    shell.removeAttribute('aria-hidden');
    document.body.style.overflow = '';
    hojaAbierta = null;
    hojaModal = false;
    marcarPestana('escribir');
    focoPrevio?.focus?.();
    focoPrevio = null;
  }

  $('ed-hoja-cerrar').addEventListener('click', cerrarHoja);
  $('ed-hoja-fondo').addEventListener('click', cerrarHoja);

  document.addEventListener('keydown', (e) => {
    if (hoja.hidden) return;
    if (e.key === 'Escape') { e.preventDefault(); return cerrarHoja(); }
    if (e.key !== 'Tab' || !hojaModal) return;
    // El tabulador da vueltas dentro de la hoja mientras está abierta.
    const foco = hojaCaja.querySelectorAll<HTMLElement>(
      'a[href], button:not([disabled]), input:not([disabled]), select, textarea, [tabindex]:not([tabindex="-1"])',
    );
    const visibles = [...foco].filter((el) => el.offsetParent !== null);
    if (visibles.length === 0) return;
    const primero = visibles[0];
    const ultimo = visibles[visibles.length - 1];
    if (e.shiftKey && document.activeElement === primero) { e.preventDefault(); ultimo.focus(); }
    else if (!e.shiftKey && document.activeElement === ultimo) { e.preventDefault(); primero.focus(); }
  });

  // ── Pestañas ──────────────────────────────────────────────
  const pestanas = [...document.querySelectorAll<HTMLButtonElement>('.ed-tab')];

  function marcarPestana(vista: string) {
    for (const p of pestanas) {
      if (p.dataset.vista === vista) p.setAttribute('aria-current', 'page');
      else p.removeAttribute('aria-current');
    }
  }

  for (const p of pestanas) {
    p.addEventListener('click', () => {
      const vista = p.dataset.vista ?? 'escribir';
      if (vista === 'escribir') { cerrarHoja(); editor.commands.focus(); return; }
      abrirHoja(vista, 'vista');
    });
  }

  // ── Bloques ───────────────────────────────────────────────
  const listaBloques = $('ed-bloques');
  COMMANDS.forEach((cmd, i) => {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'ed-bloque';
    b.innerHTML =
      '<span class="ed-bloque-ico" aria-hidden="true"></span>' +
      '<span><span class="ed-bloque-nom"></span><span class="ed-bloque-sub"></span></span>';
    (b.querySelector('.ed-bloque-ico') as HTMLElement).textContent = cmd.ico;
    (b.querySelector('.ed-bloque-nom') as HTMLElement).textContent = cmd.label;
    (b.querySelector('.ed-bloque-sub') as HTMLElement).textContent = cmd.sub;
    b.addEventListener('click', () => {
      cerrarHoja();
      editor.commands.focus();
      COMMANDS[i].run();
    });
    listaBloques.appendChild(b);
  });

  // ── Barra de formato ──────────────────────────────────────
  const tools = $('ed-tools');
  const botones = [...tools.querySelectorAll<HTMLButtonElement>('.ed-tool')];

  const ACCIONES: Record<string, () => void> = {
    bloques: () => abrirHoja('bloques'),
    negrita: () => chain().toggleBold().run(),
    cursiva: () => chain().toggleItalic().run(),
    h2: () => chain().toggleHeading({ level: 2 }).run(),
    vinetas: () => chain().toggleBulletList().run(),
    numerada: () => chain().toggleOrderedList().run(),
    cita: () => chain().toggleBlockquote().run(),
    enlace: promptLink,
    imagen: () => els.file.click(),
    deshacer: () => chain().undo().run(),
    rehacer: () => chain().redo().run(),
  };

  /** Qué marca de Tiptap mira cada botón para encenderse. */
  const ACTIVO: Record<string, [string, Record<string, unknown>?]> = {
    negrita: ['bold'],
    cursiva: ['italic'],
    h2: ['heading', { level: 2 }],
    vinetas: ['bulletList'],
    numerada: ['orderedList'],
    cita: ['blockquote'],
  };

  for (const b of botones) {
    // Con `mousedown` el editor perdería el cursor antes de ejecutar la acción.
    b.addEventListener('mousedown', (e) => e.preventDefault());
    b.addEventListener('click', () => {
      const accion = b.dataset.accion ?? '';
      ACCIONES[accion]?.();
      pintarEstadoTools();
    });
  }

  function pintarEstadoTools() {
    for (const b of botones) {
      const marca = ACTIVO[b.dataset.accion ?? ''];
      if (!marca) continue;
      b.setAttribute('aria-pressed', String(editor.isActive(marca[0], marca[1] as any)));
    }
  }

  const enTelefono = () => window.matchMedia('(max-width: 820px)').matches;

  function mostrarTools(visible: boolean) {
    tools.hidden = !visible || !enTelefono();
  }

  editor.on('focus', () => mostrarTools(true));
  editor.on('selectionUpdate', pintarEstadoTools);
  editor.on('transaction', pintarEstadoTools);
  // El foco se va tambien al tocar un boton de la barra: se espera un instante
  // para no esconderla justo cuando se va a usar.
  editor.on('blur', () => setTimeout(() => {
    if (!tools.contains(document.activeElement)) mostrarTools(false);
  }, 120));

  // ── El teclado del teléfono tapa la barra ─────────────────
  const vv = window.visualViewport;
  function seguirTeclado() {
    if (!vv) return;
    const tapado = Math.max(0, window.innerHeight - vv.height - vv.offsetTop);
    shell.style.setProperty('--ed-teclado', `${Math.round(tapado)}px`);
    shell.dataset.teclado = tapado > 120 ? 'si' : 'no';
    tools.style.setProperty('--ed-teclado', `${Math.round(tapado)}px`);
  }
  vv?.addEventListener('resize', seguirTeclado);
  vv?.addEventListener('scroll', seguirTeclado);
  seguirTeclado();

  window.addEventListener('resize', () => { if (!enTelefono()) tools.hidden = true; });

  // ── Datos de la entrada, plegados ─────────────────────────
  const detalles = $<HTMLDetailsElement>('ed-detalles');
  const detallesResumen = $('ed-detalles-resumen');

  function pintarResumenDetalles() {
    const partes = [els.categoria.value.trim(), els.fecha.value, els.draft.checked ? 'borrador' : '']
      .filter(Boolean);
    detallesResumen.textContent = partes.join(' · ');
  }
  [els.categoria, els.fecha, els.draft].forEach((el) =>
    el.addEventListener('input', pintarResumenDetalles));
  pintarResumenDetalles();
  // En pantalla ancha no hay razón para esconderlos.
  if (!enTelefono()) detalles.open = true;

  // ── Ajustes ───────────────────────────────────────────────
  let instalacion: any = null;
  const instalado = () =>
    window.matchMedia('(display-mode: standalone)').matches ||
    (navigator as any).standalone === true;

  function pintarAjustes() {
    const oscuro = document.documentElement.getAttribute('data-theme') === 'dark';
    $('ed-tema-sub').textContent = oscuro ? 'Oscuro' : 'Claro';
    $('ed-acceso-sub').textContent = getToken() ? 'Token guardado' : 'Sin token';

    const esApple = /iPhone|iPad|iPod/.test(navigator.userAgent);
    $('ed-instalada').hidden = !instalado();
    $('ed-instalar').hidden = instalado() || !instalacion;
    $('ed-instalar-ios').hidden = instalado() || !esApple || !!instalacion;
  }

  $('ed-tema').addEventListener('click', () => {
    const oscuro = document.documentElement.getAttribute('data-theme') === 'dark';
    const nuevo = oscuro ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', nuevo);
    localStorage.setItem('theme', nuevo);
    pintarAjustes();
  });

  $('ed-ir-acceso').addEventListener('click', () => abrirHoja('acceso'));
  $('ed-ir-diagramas').addEventListener('click', () => {
    abrirHoja('diagramas');
    dibujarDiagramas();
  });

  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    instalacion = e;
    if (hojaAbierta === 'ajustes') pintarAjustes();
  });

  $('ed-instalar').addEventListener('click', async () => {
    if (!instalacion) return;
    instalacion.prompt();
    await instalacion.userChoice;
    instalacion = null;
    pintarAjustes();
  });

  window.addEventListener('appinstalled', () => {
    instalacion = null;
    toast('App instalada. Ábrela desde su icono.');
    pintarAjustes();
  });

  // ── Service worker ────────────────────────────────────────
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js').catch(() => {
        /* sin service worker la app sigue funcionando: solo pierde el modo sin conexión */
      });
    });
  }

  // ── Atajos del icono de la app ────────────────────────────
  const parametros = new URLSearchParams(location.search);
  if (parametros.get('nueva')) nuevaEntrada();
  const vista = parametros.get('vista');
  if (vista && SECCIONES[vista]) abrirHoja(vista, 'vista');
  if (parametros.has('nueva') || parametros.has('vista')) {
    history.replaceState(null, '', location.pathname);
  }

</script>
</html>
